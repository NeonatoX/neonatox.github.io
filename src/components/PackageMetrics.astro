---
interface PackageInfo {
  name: string;
  last: string;
  desc: string;
}

const allPackages: Record<string, PackageInfo> = {};
let totalCount = 0;

try {
  const pages = Array.from({length: 10}, (_, i) => i + 1);
  const results = await Promise.all(
    pages.map(page =>
      fetch(`https://gitlab.com/api/v4/groups/neonatox-sources/projects?per_page=100&page=${page}`)
        .then(r => r.json())
        .catch(() => [])
    )
  );
  for (const data of results) {
    for (const item of data as Array<any>) {
      const name: string = item.name;
      allPackages[name] = {
        name,
        last: (item.last_activity_at || '').slice(0, 10),
        desc: (item.description || '').slice(0, 100),
      };
    }
  }
  totalCount = Object.keys(allPackages).length;
} catch {
  totalCount = 0;
}

const pkgList = Object.values(allPackages);

// Most active (last 30 days)
const now = new Date();
const last30 = pkgList.filter(p => {
  if (!p.last) return false;
  const d = new Date(p.last);
  return (now.getTime() - d.getTime()) / 86400000 <= 30;
});

const last365 = pkgList.filter(p => {
  if (!p.last) return false;
  const d = new Date(p.last);
  return (now.getTime() - d.getTime()) / 86400000 <= 365;
});

// Most recent
const recent = [...pkgList].sort((a, b) => b.last.localeCompare(a.last)).slice(0, 12);

// Categories
const cats: Record<string, number> = {};
for (const p of pkgList) {
  const name = p.name;
  if (name.startsWith('gnome-') || name.startsWith('gnome')) cats['GNOME'] = (cats['GNOME'] || 0) + 1;
  else if (name.startsWith('plasma-') || name.startsWith('kde') || ['systemsettings','spectacle','sddm-kcm','qqc2-breeze-style','print-manager','powerdevil','polkit-kde-agent','plasma-workspace-wallpapers','plasma-workspace','plasma-welcome','plasma-vault','plasma-systemmonitor','plasma-setup','wacomtablet','kpmcore','kcal','kate','kdeconnect','aurorae','bluedevil','breeze','breeze-gtk','breeze-icons'].includes(name)) cats['KDE / Plasma'] = (cats['KDE / Plasma'] || 0) + 1;
  else if (name.startsWith('xfce') || name.startsWith('xfwl') || name.startsWith('adwaita-xfce')) cats['XFCE'] = (cats['XFCE'] || 0) + 1;
  else if (name.startsWith('lib') || name.startsWith('lib')) cats['Librerías'] = (cats['Librerías'] || 0) + 1;
  else if (name.startsWith('qt') || name.startsWith('sdl')) cats['Toolkits'] = (cats['Toolkits'] || 0) + 1;
  else if (name.startsWith('python-')) cats['Python'] = (cats['Python'] || 0) + 1;
  else if (name.startsWith('perl-')) cats['Perl'] = (cats['Perl'] || 0) + 1;
  else if (name.startsWith('webkit')) cats['Web Engines'] = (cats['Web Engines'] || 0) + 1;
  else if (name.startsWith('proto') || name.startsWith('protobuf')) cats['Protocolos'] = (cats['Protocolos'] || 0) + 1;
  else if (name.startsWith('xdg-') || name.startsWith('adwaita-')) cats['Desktop'] = (cats['Desktop'] || 0) + 1;
  else if (name === 'linux' || name === 'linux-lts' || name === 'linux-api-headers') cats['Kernel'] = (cats['Kernel'] || 0) + 1;
  else cats['Aplicaciones / Otros'] = (cats['Aplicaciones / Otros'] || 0) + 1;
}

const sortedCats = Object.entries(cats).sort((a, b) => b[1] - a[1]);
const maxCat = sortedCats[0]?.[1] || 1;
const initialTotal = totalCount;
const apiUrl = 'https://gitlab.com/api/v4/groups/neonatox-sources/projects?per_page=1';
---

<div class="space-y-16">

  <!-- Metrics Hero -->
  <div id="metrics-hero" class="grid grid-cols-2 md:grid-cols-4 gap-4">
    <div class="bg-gray-100 p-6 rounded-xl border border-gray-200 text-center">
      <div id="metrics-total" class="text-4xl font-bold text-cyan-400 mb-1">{totalCount}</div>
      <div class="text-sm text-gray-500">paquetes totales</div>
    </div>
    <div class="bg-gray-100 p-6 rounded-xl border border-gray-200 text-center">
      <div class="text-4xl font-bold text-emerald-600 mb-1">{last30.length}</div>
      <div class="text-sm text-gray-500">activos (30d)</div>
    </div>
    <div class="bg-gray-100 p-6 rounded-xl border border-gray-200 text-center">
      <div class="text-4xl font-bold text-purple-600 mb-1">{last365.length}</div>
      <div class="text-sm text-gray-500">activos (1 año)</div>
    </div>
    <div class="bg-gray-100 p-6 rounded-xl border border-gray-200 text-center">
      <div class="text-4xl font-bold text-amber-600 mb-1">{sortedCats.length}</div>
      <div class="text-sm text-gray-500">categorías</div>
    </div>
  </div>

  <!-- Categories -->
  <div>
    <h3 class="text-xl font-semibold text-gray-900 mb-6">Distribución por categoría</h3>
    <div class="space-y-3">
      {sortedCats.map(([cat, count]) => (
        <div>
          <div class="flex justify-between text-sm mb-1">
            <span class="text-gray-600">{cat}</span>
            <span class="text-gray-500">{count}</span>
          </div>
          <div class="w-full bg-gray-200 rounded-full h-2 overflow-hidden">
            <div
              class="h-full rounded-full bg-gradient-to-r from-cyan-500 to-purple-500"
              style={`width: ${(count / maxCat) * 100}%`}
            ></div>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Recent packages -->
  <div>
    <h3 class="text-xl font-semibold text-gray-900 mb-6">Paquetes actualizados recientemente</h3>
    <div class="grid md:grid-cols-2 gap-3">
      {recent.map(p => (
        <a
          href={`https://gitlab.com/neonatox-sources/${p.name}`}
          target="_blank"
          class="bg-gray-50 p-4 rounded-lg border border-gray-200 hover:border-cyan-500/50 transition-colors flex justify-between items-center"
        >
          <span class="text-cyan-400 font-mono text-sm">{p.name}</span>
          <span class="text-xs text-gray-400">{p.last}</span>
        </a>
      ))}
    </div>
  </div>

</div>

<script define:vars={{ initialTotal, apiUrl }}>
(async () => {
  try {
    const res = await fetch(apiUrl);
    const newTotal = parseInt(res.headers.get('x-total') || '0');
    if (newTotal && newTotal !== initialTotal) {
      const el = document.getElementById('metrics-total');
      if (el) el.textContent = String(newTotal);
    }
  } catch {
    // fallback: show build-time value
  }
})();
</script>
