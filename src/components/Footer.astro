---
const currentLang = Astro.params.lang || 'es';
---
<footer class="bg-gray-50 border-t border-gray-200 py-8 mt-16">
  <div class="max-w-6xl mx-auto px-4 text-center text-gray-500 text-sm">
    <p>NEONATOX &copy; 2026 — {currentLang === 'es' ? 'Abre la caja. Descubre y experimenta sin atajos.' : currentLang === 'en' ? 'Open the box. Discover and experiment without shortcuts.' : 'Abra a caixa. Descubra e experimente sem atalhos.'}</p>
    <div class="flex justify-center gap-4 mt-4">
      <a href={`/${currentLang}/paquetes`} class="text-cyan-500 hover:text-cyan-700">Paquetes</a>
      <a href={`/${currentLang}/arquitectura`} class="text-cyan-500 hover:text-cyan-700">Arquitectura</a>
      <a href={`/${currentLang}/ruta-constructor`} class="text-cyan-500 hover:text-cyan-700">{currentLang === 'es' ? 'Ruta del Constructor' : currentLang === 'en' ? 'Builder Path' : 'Caminho do Construtor'}</a>
    </div>
  </div>
</footer>