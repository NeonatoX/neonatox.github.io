---
interface Slide {
  src: string;
  alt: string;
}

const slides: Slide[] = [
  { src: '/screenshots/gnome50.png', alt: 'GNOME 50' },
  { src: '/screenshots/xfce.png', alt: 'XFCE' },
  { src: '/screenshots/kde.png', alt: 'KDE' },
  { src: '/screenshots/nhopkg.png', alt: 'nhopkg' },
  { src: '/screenshots/live-boot1.png', alt: 'Live Boot' },
  { src: '/screenshots/live-boot2.png', alt: 'Live Boot 2' },
];

const total = slides.length;
const id = 'ss-' + Math.random().toString(36).slice(2, 7);
---

<div class="relative group" id={id}>
  <div class="overflow-hidden rounded-xl border border-slate-700">
    <div class="flex transition-transform duration-500 ease-in-out" id={`${id}-track`} style="transform: translateX(0)">
      {slides.map(s => (
        <a
          href={s.src}
          target="_blank"
          class="min-w-full block cursor-zoom-in select-none"
          draggable="false"
        >
          <img src={s.src} alt={s.alt} class="w-full h-auto pointer-events-none" loading="lazy" draggable="false" />
        </a>
      ))}
    </div>
  </div>

  <button id={`${id}-prev`}
    class="absolute left-2 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-slate-900/70 border border-slate-500 text-white hover:bg-slate-600 transition-colors flex items-center justify-center text-2xl opacity-0 group-hover:opacity-100 focus:opacity-100"
    aria-label="Previous">‹</button>
  <button id={`${id}-next`}
    class="absolute right-2 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-slate-900/70 border border-slate-500 text-white hover:bg-slate-600 transition-colors flex items-center justify-center text-2xl opacity-0 group-hover:opacity-100 focus:opacity-100"
    aria-label="Next">›</button>

  <div class="flex justify-center gap-2 mt-4">
    {Array.from({ length: total }, (_, i) => (
      <button
        class={`w-2.5 h-2.5 rounded-full border border-slate-500 transition-all duration-300 ${i === 0 ? 'bg-cyan-400 border-cyan-400' : 'bg-transparent'}`}
        data-index={i}
        aria-label={`Slide ${i + 1}`}
      ></button>
    ))}
  </div>
</div>

<script define:vars={{ id, total }}>
(function() {
  const container = document.getElementById(id);
  const track = document.getElementById(id + '-track');
  const prev = document.getElementById(id + '-prev');
  const next = document.getElementById(id + '-next');
  const dots = container?.querySelectorAll('[data-index]');
  if (!track || !container) return;

  let current = 0;
  let autoplayTimer;

  function goTo(index) {
    if (index < 0) index = total - 1;
    if (index >= total) index = 0;
    current = index;
    track.style.transform = 'translateX(-' + (current * 100) + '%)';
    dots?.forEach((dot, i) => {
      dot.classList.toggle('bg-cyan-400', i === current);
      dot.classList.toggle('border-cyan-400', i === current);
      dot.classList.toggle('bg-transparent', i !== current);
    });
  }

  function start() { stop(); autoplayTimer = setInterval(function() { goTo(current + 1); }, 5000); }
  function stop() { if (autoplayTimer) clearInterval(autoplayTimer); }

  prev?.addEventListener('click', function() { goTo(current - 1); start(); });
  next?.addEventListener('click', function() { goTo(current + 1); start(); });
  dots?.forEach(function(dot) {
    dot.addEventListener('click', function() {
      goTo(parseInt(dot.getAttribute('data-index') || '0'));
      start();
    });
  });

  container.addEventListener('mouseenter', stop);
  container.addEventListener('mouseleave', start);
  container.addEventListener('touchstart', stop);
  container.addEventListener('touchend', start);

  start();
})();
</script>
