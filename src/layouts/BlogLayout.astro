---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  lang: 'es' | 'en' | 'pt';
  pubDate: Date;
  author?: string;
  tags?: string[];
}

const { title, description, lang, pubDate, author, tags = [] } = Astro.props;
const labels = {
  es: { back: '← Volver al blog', by: 'por' },
  en: { back: '← Back to blog', by: 'by' },
  pt: { back: '← Voltar ao blog', by: 'por' },
};
---

<BaseLayout title={title} description={description} lang={lang}>
  <article class="max-w-3xl mx-auto px-4 py-16">
    <a href={`/${lang}/blog`} class="text-cyan-500 hover:text-cyan-700 mb-8 inline-block">{labels[lang].back}</a>

    <header class="mb-10">
      <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">{title}</h1>
      <div class="flex flex-wrap items-center gap-3 text-sm text-gray-500">
        <time datetime={pubDate.toISOString()}>{pubDate.toLocaleDateString(lang, { year: 'numeric', month: 'long', day: 'numeric' })}</time>
        {author && <span class="text-gray-400">·</span>}
        {author && <span>{labels[lang].by} {author}</span>}
        {tags.length > 0 && (
          <div class="flex gap-2">
            {tags.map(tag => (
              <span class="bg-gray-200 text-gray-600 px-2 py-0.5 rounded text-xs">{tag}</span>
            ))}
          </div>
        )}
      </div>
    </header>

    <div class="max-w-none text-gray-700 leading-relaxed [&_h2]:text-gray-900 [&_h2]:text-2xl [&_h2]:font-bold [&_h2]:mt-12 [&_h2]:mb-4 [&_h3]:text-gray-900 [&_h3]:text-xl [&_h3]:font-semibold [&_h3]:mt-8 [&_h3]:mb-3 [&_p]:mb-5 [&_a]:text-cyan-600 [&_a:hover]:text-cyan-500 [&_ul]:list-disc [&_ul]:pl-6 [&_ul]:mb-4 [&_li]:mb-1 [&_hr]:border-gray-200 [&_hr]:my-10 [&_code]:bg-gray-100 [&_code]:text-emerald-700 [&_code]:px-1.5 [&_code]:py-0.5 [&_code]:rounded [&_code]:text-sm [&_strong]:text-gray-900 [&_blockquote]:border-l-4 [&_blockquote]:border-cyan-500 [&_blockquote]:pl-4 [&_blockquote]:italic [&_blockquote]:text-gray-500 [&_blockquote]:my-6 [&_blockquote]:text-lg">
      <slot />
    </div>
  </article>
</BaseLayout>
