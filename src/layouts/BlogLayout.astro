---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  lang: 'es' | 'en' | 'pt';
  pubDate: Date;
  tags?: string[];
}

const { title, description, lang, pubDate, tags = [] } = Astro.props;
const backLabel = { es: '← Volver al blog', en: '← Back to blog', pt: '← Voltar ao blog' };
---

<BaseLayout title={title} description={description} lang={lang}>
  <article class="max-w-3xl mx-auto px-4 py-16">
    <a href={`/${lang}/blog`} class="text-cyan-500 hover:text-cyan-700 mb-8 inline-block">{backLabel[lang]}</a>

    <header class="mb-10">
      <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">{title}</h1>
      <div class="flex flex-wrap items-center gap-3 text-sm text-gray-500">
        <time datetime={pubDate.toISOString()}>{pubDate.toLocaleDateString(lang, { year: 'numeric', month: 'long', day: 'numeric' })}</time>
        {tags.length > 0 && (
          <div class="flex gap-2">
            {tags.map(tag => (
              <span class="bg-gray-200 text-gray-600 px-2 py-0.5 rounded text-xs">{tag}</span>
            ))}
          </div>
        )}
      </div>
    </header>

    <div class="prose max-w-none text-gray-700 leading-relaxed [&amp;_h2]:text-gray-900 [&amp;_h2]:text-2xl [&amp;_h2]:font-bold [&amp;_h2]:mt-12 [&amp;_h2]:mb-4 [&amp;_h3]:text-gray-900 [&amp;_h3]:text-xl [&amp;_h3]:font-semibold [&amp;_h3]:mt-8 [&amp;_h3]:mb-3 [&amp;_p]:mb-4 [&amp;_a]:text-cyan-600 [&amp;_a:hover]:text-cyan-500 [&amp;_ul]:list-disc [&amp;_ul]:pl-6 [&amp;_ul]:mb-4 [&amp;_li]:mb-1 [&amp;_hr]:border-gray-200 [&amp;_hr]:my-10 [&amp;_code]:bg-gray-100 [&amp;_code]:text-emerald-700 [&amp;_code]:px-1.5 [&amp;_code]:py-0.5 [&amp;_code]:rounded [&amp;_code]:text-sm [&amp;_strong]:text-gray-900 [&amp;_blockquote]:border-l-4 [&amp;_blockquote]:border-cyan-500 [&amp;_blockquote]:pl-4 [&amp;_blockquote]:italic [&amp;_blockquote]:text-gray-500 [&amp;_blockquote]:my-6 [&amp;_blockquote]:text-lg">
      <slot />
    </div>
  </article>
</BaseLayout>
