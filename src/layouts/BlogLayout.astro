---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  lang: 'es' | 'en' | 'pt';
  pubDate: Date;
  tags?: string[];
}

const { title, description, lang, pubDate, tags = [] } = Astro.props;
const backLabel = { es: '← Volver al blog', en: '← Back to blog', pt: '← Voltar ao blog' };
---

<BaseLayout title={title} description={description} lang={lang}>
  <article class="max-w-3xl mx-auto px-4 py-16">
    <a href={`/${lang}/blog`} class="text-cyan-400 hover:text-cyan-300 mb-8 inline-block">{backLabel[lang]}</a>

    <header class="mb-10">
      <h1 class="text-3xl md:text-4xl font-bold text-white mb-4">{title}</h1>
      <div class="flex flex-wrap items-center gap-3 text-sm text-slate-400">
        <time datetime={pubDate.toISOString()}>{pubDate.toLocaleDateString(lang, { year: 'numeric', month: 'long', day: 'numeric' })}</time>
        {tags.length > 0 && (
          <div class="flex gap-2">
            {tags.map(tag => (
              <span class="bg-slate-700 text-slate-300 px-2 py-0.5 rounded text-xs">{tag}</span>
            ))}
          </div>
        )}
      </div>
    </header>

    <div class="prose prose-invert max-w-none text-slate-200 leading-relaxed [&_h2]:text-white [&_h2]:text-2xl [&_h2]:font-bold [&_h2]:mt-12 [&_h2]:mb-4 [&_h3]:text-white [&_h3]:text-xl [&_h3]:font-semibold [&_h3]:mt-8 [&_h3]:mb-3 [&_p]:mb-4 [&_a]:text-cyan-400 [&_a:hover]:text-cyan-300 [&_ul]:list-disc [&_ul]:pl-6 [&_ul]:mb-4 [&_li]:mb-1 [&_hr]:border-slate-700 [&_hr]:my-10 [&_code]:bg-slate-800 [&_code]:text-green-400 [&_code]:px-1.5 [&_code]:py-0.5 [&_code]:rounded [&_code]:text-sm [&_strong]:text-white [&_blockquote]:border-l-4 [&_blockquote]:border-cyan-500 [&_blockquote]:pl-4 [&_blockquote]:italic [&_blockquote]:text-slate-400 [&_blockquote]:my-6 [&_blockquote]:text-lg">
      <slot />
    </div>
  </article>
</BaseLayout>
