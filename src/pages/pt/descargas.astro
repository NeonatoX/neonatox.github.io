---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { dict } from '../../utils/i18n';
const t = dict.pt;
---

<BaseLayout title="Downloads" description="Baixar Neonatox ISO" lang="pt">
  <section class="py-20 px-4">
    <div class="max-w-4xl mx-auto">
      <h1 class="text-4xl font-bold text-cyan-400 mb-8">Downloads</h1>
      <p class="text-xl text-slate-300 mb-12">
        Obtenha o Neonatox e experimente na sua máquina.
      </p>

      <!-- ISO Principal -->
      <div class="bg-slate-800/50 p-8 rounded-xl border border-slate-700 mb-8">
        <div class="flex items-center justify-between mb-6">
          <div>
            <h2 class="text-2xl font-bold text-white">Neonatox ISO</h2>
            <p class="text-slate-400">Imagem live ready-to-use</p>
          </div>
          <span class="bg-yellow-500/20 text-yellow-400 px-3 py-1 rounded-full text-sm">Em breve</span>
        </div>
        
        <div class="grid md:grid-cols-2 gap-6">
          <div class="bg-slate-900 p-4 rounded-lg">
            <h3 class="text-cyan-400 font-semibold mb-2">Informações da imagem</h3>
            <ul class="text-slate-400 text-sm space-y-1">
              <li><strong>Versão:</strong> --</li>
              <li><strong>Arquitetura:</strong> x86_64</li>
              <li><strong>Tamanho:</strong> --</li>
              <li><strong>Kernel:</strong> --</li>
            </ul>
          </div>
          <div class="bg-slate-900 p-4 rounded-lg">
            <h3 class="text-cyan-400 font-semibold mb-2">SHA256</h3>
            <code class="text-slate-500 text-xs break-all">--</code>
          </div>
        </div>
      </div>

      <!-- Opciones de descarga -->
      <div class="grid md:grid-cols-2 gap-6 mb-12">
        <div class="bg-slate-800/30 p-6 rounded-lg border border-slate-700 opacity-75">
          <div class="flex items-center gap-3 mb-4">
            <span class="text-2xl">🌐</span>
            <div>
              <h3 class="text-white font-semibold">Download direto</h3>
              <p class="text-slate-400 text-sm">HTTP</p>
            </div>
          </div>
          <p class="text-slate-500 text-sm">Em breve disponível</p>
        </div>

        <div class="bg-slate-800/30 p-6 rounded-lg border border-slate-700 opacity-75">
          <div class="flex items-center gap-3 mb-4">
            <span class="text-2xl">🔗</span>
            <div>
              <h3 class="text-white font-semibold">Torrent</h3>
              <p class="text-slate-400 text-sm">P2P</p>
            </div>
          </div>
          <p class="text-slate-500 text-sm">Em breve disponível</p>
        </div>
      </div>

      <!-- Requisitos -->
      <div class="bg-slate-800/50 p-6 rounded-lg border border-slate-700 mb-8">
        <h2 class="text-xl font-bold text-cyan-300 mb-4">Requisitos do sistema</h2>
        <ul class="space-y-2 text-slate-300">
          <li>• <strong>CPU:</strong> x86_64 (compatível com AMD64 ou Intel 64)</li>
          <li>• <strong>RAM:</strong> Mínimo 2GB, recomendado 4GB+</li>
          <li>• <strong>Armazenamento:</strong> 10GB livres para instalação</li>
          <li>• <strong>Gráficos:</strong> Driver DRM compatível (Intel, AMD, NVIDIA)</li>
        </ul>
      </div>

      <!-- Instalação -->
      <div class="bg-slate-800/50 p-6 rounded-lg border border-slate-700">
        <h2 class="text-xl font-bold text-cyan-300 mb-4">Como instalar</h2>
        <ol class="list-decimal list-slate-300 space-y-2 pl-4">
          <li>Baixe a imagem ISO</li>
          <li>Verifique o hash SHA256</li>
          <li>Grave a ISO em um USB (use <code>dd</code> ou Ventoy)</li>
          <li>Inicie pelo USB</li>
          <li>Execute o instalador a partir do desktop live</li>
        </ol>
        <p class="text-slate-400 text-sm mt-4">
          Mais detalhes em <a href="/pt/proyectos/installer" class="text-cyan-400 hover:text-cyan-300 underline">Neonatox Installer</a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>