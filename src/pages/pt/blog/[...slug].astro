---
import BlogLayout from '../../../layouts/BlogLayout.astro';
import {
  getAllPosts,
  getLocaleFromSlug,
  getSlugFromSlug,
} from '../../../utils/blog';

export async function getStaticPaths() {
  const allPosts = await getAllPosts();
  // Nota: literal 'pt' dentro de getStaticPaths (limitación de Astro
  // con las constantes de nivel superior en esta función).
  return allPosts
    .filter((post) => getLocaleFromSlug(post.slug) === 'pt')
    .map((post) => ({
      params: { slug: getSlugFromSlug(post.slug) },
      props: { post },
    }));
}

const { post } = Astro.props;
const allPosts = await getAllPosts();
---

<BlogLayout post={post} lang="pt" allPosts={allPosts} />
