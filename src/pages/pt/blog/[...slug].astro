---
import BlogLayout from '../../../layouts/BlogLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ slug }) => slug.startsWith('pt/'));
  return posts.map(post => ({
    params: { slug: post.slug.replace('pt/', '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
---

<BlogLayout title={post.data.title} description={post.data.description} lang="pt" pubDate={post.data.pubDate} tags={post.data.tags}>
  <Content />
</BlogLayout>
