---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog', ({ slug }) => slug.startsWith('pt/'));
posts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<BaseLayout title="Blog" description="Blog do Neonatox" lang="pt">
  <section class="max-w-3xl mx-auto px-4 py-16">
    <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-2">Blog</h1>
    <p class="text-gray-500 mb-10">Notícias, guias e reflexões sobre o Neonatox.</p>

    {posts.length === 0 && <p class="text-gray-400">Nenhum artigo ainda.</p>}

    <div class="space-y-6">
      {posts.map(post => (
        <a href={`/pt/blog/${post.slug.replace('pt/', '')}`} class="block bg-gray-100 p-6 rounded-xl border border-gray-200 hover:border-cyan-500/50 transition-colors">
          <h2 class="text-xl font-semibold text-gray-900 mb-2">{post.data.title}</h2>
          <p class="text-gray-500 text-sm mb-3">{post.data.description}</p>
          <div class="flex items-center gap-3 text-xs text-gray-400">
            <time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString('pt', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
            {post.data.tags?.map(tag => <span class="bg-gray-200 text-gray-500 px-2 py-0.5 rounded">{tag}</span>)}
          </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
