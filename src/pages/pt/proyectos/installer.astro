---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { dict } from '../../../utils/i18n';
const t = dict.pt;
---

<BaseLayout title="Installer - Instalador modular" description="Framework de instalação modular baseado em estado" lang="pt">
  <section class="py-20 px-4">
    <div class="max-w-4xl mx-auto">
      <div class="flex items-center gap-4 mb-8">
        <a href="/pt/proyectos" class="text-cyan-400 hover:text-cyan-300">← Projetos</a>
      </div>

      <div class="flex items-center gap-4 mb-8">
        <div class="w-16 h-16 bg-yellow-500/20 rounded-xl flex items-center justify-center text-4xl">⚙️</div>
        <div>
          <h1 class="text-4xl font-bold text-yellow-400">Neonatox Installer</h1>
          <p class="text-xl text-yellow-400/70">Framework de instalação modular</p>
        </div>
      </div>

      <div class="flex gap-4 mb-8">
        <a href="https://github.com/cargabsj175/neonatox-installer" target="_blank" class="bg-yellow-500 hover:bg-yellow-400 text-slate-900 font-semibold px-6 py-3 rounded-lg transition-colors">
          {t.verRepos} →
        </a>
        <span class="bg-yellow-500/20 text-yellow-400 px-3 py-2 rounded-lg text-sm">{t.experimental}</span>
      </div>

      <div class="bg-slate-800/50 p-6 rounded-lg border border-slate-700 mb-8">
        <h2 class="text-2xl font-semibold text-yellow-300 mb-4">Descrição</h2>
        <p class="text-slate-300">
          Framework de instalação portátil, modular e baseado em estado, projetado para sistemas live 
          gerados com <strong>neonatox-live-boot</strong>.
        </p>
        <p class="text-slate-300 mt-4">
          O instalador <strong>não é um script monolônico</strong>, mas um conjunto de micro-aplicações 
          que trabalham independentemente, armazenam estado em arquivos `.conf` + `.ok`, e podem 
          ser chamadas de CLI, TUI ou GUI.
        </p>
      </div>

      <div class="bg-slate-800/30 p-6 rounded-lg border border-slate-700 mb-8">
        <h3 class="text-xl font-semibold text-yellow-300 mb-4">Micro-aplicações</h3>
        <div class="grid grid-cols-2 md:grid-cols-3 gap-4 text-sm">
          <div class="bg-slate-900 p-3 rounded"><span class="text-yellow-400">partctl</span><p class="text-slate-500 text-xs">Partições</p></div>
          <div class="bg-slate-900 p-3 rounded"><span class="text-yellow-400">localectl</span><p class="text-slate-500 text-xs">Locale/Teclado</p></div>
          <div class="bg-slate-900 p-3 rounded"><span class="text-yellow-400">timectl</span><p class="text-slate-500 text-xs">Fuso horário</p></div>
          <div class="bg-slate-900 p-3 rounded"><span class="text-yellow-400">usersctl</span><p class="text-slate-500 text-xs">Usuários</p></div>
          <div class="bg-slate-900 p-3 rounded"><span class="text-yellow-400">fstabctl</span><p class="text-slate-500 text-xs">fstab</p></div>
          <div class="bg-slate-900 p-3 rounded"><span class="text-yellow-400">bootctl</span><p class="text-slate-500 text-xs">Bootloader</p></div>
          <div class="bg-slate-900 p-3 rounded"><span class="text-yellow-400">systemid</span><p class="text-slate-500 text-xs">Hostname</p></div>
          <div class="bg-slate-900 p-3 rounded"><span class="text-yellow-400">sysconfig</span><p class="text-slate-500 text-xs">Config sistema</p></div>
          <div class="bg-slate-900 p-3 rounded"><span class="text-yellow-400">distroinfo</span><p class="text-slate-500 text-xs">OS release</p></div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>