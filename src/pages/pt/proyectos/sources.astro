---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PackageMetrics from '../../../components/PackageMetrics.astro';
---

<BaseLayout title="Sources - Repositório de pacotes" description="Repositório GitLab com pacotes fonte" lang="pt">
  <section class="py-20 px-4">
    <div class="max-w-4xl mx-auto">
      <div class="flex items-center gap-4 mb-8">
        <a href="/pt/proyectos" class="text-cyan-400 hover:text-cyan-300">← Projetos</a>
      </div>

      <div class="flex items-center gap-4 mb-8">
        <div class="w-16 h-16 bg-red-500/20 rounded-xl flex items-center justify-center text-4xl">📚</div>
        <div>
          <h1 class="text-4xl font-bold text-red-400">neonatox-sources</h1>
          <p class="text-xl text-red-400/70">Repositório de pacotes fonte</p>
        </div>
      </div>

      <div class="flex gap-4 mb-8">
        <a href="https://gitlab.com/neonatox-sources" target="_blank" class="bg-red-500 hover:bg-red-400 text-slate-900 font-semibold px-6 py-3 rounded-lg transition-colors">
          Ver repositório →
        </a>
        <span class="bg-slate-500/20 text-slate-400 px-3 py-2 rounded-lg text-sm">GitLab</span>
      </div>

      <div class="bg-slate-800/50 p-6 rounded-lg border border-slate-700 mb-12">
        <h2 class="text-2xl font-semibold text-red-300 mb-4">Descrição</h2>
        <p class="text-slate-300">
          Repositório GitLab com pacotes fonte em constante atualização. Constitui a base de construção do Neonatox.
        </p>
        <p class="text-slate-300 mt-4">
          Aqui você encontrará os arquivos necessários para compilar cada pacote do sistema, incluindo scripts de build, patches e metadados.
        </p>
      </div>

      <PackageMetrics />

      <div class="bg-red-500/10 border border-red-500/30 rounded-lg p-6 mt-12">
        <p class="text-red-300">
          <strong>Nota:</strong> Este repositório é somente leitura para referência. Os pacotes são construídos localmente usando nhopkg.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
