---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { dict } from '../../utils/i18n';
const t = dict.es;
const p = t.portal;
---

<BaseLayout
  title="Portal de Fuentes de NeonatoX | Sistema de paquetes"
  description="El catálogo de paquetes, recetas nhoid y dependencias de NeonatoX viven en el Portal de Fuentes. Explora el repositorio."
  lang="es"
  alternates={[
    { hreflang: 'es', href: '/es/paquetes' },
    { hreflang: 'en', href: '/en/paquetes' },
    { hreflang: 'pt', href: '/pt/paquetes' },
    { hreflang: 'x-default', href: '/es/paquetes' }
  ]}
>
  <main class="max-w-5xl mx-auto px-6 py-16 text-gray-900">
    <!-- Hero -->
    <section class="mb-12">
      <p class="text-sm font-semibold uppercase tracking-widest text-cyan-600 mb-3">{p.eyebrow}</p>
      <h1 class="text-4xl md:text-5xl font-bold mb-6">{p.title}</h1>
      <p class="text-gray-600 text-lg leading-relaxed mb-8 max-w-3xl">{p.lead}</p>
      <div class="flex flex-wrap items-center gap-4">
        <a
          href="https://neonatox-sources.gitlab.io/"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-gradient-to-r from-cyan-500 to-purple-500 hover:from-cyan-400 hover:to-purple-400 text-white font-bold px-8 py-4 rounded-xl shadow-lg shadow-cyan-500/20 transition-all"
        >
          {p.button} <span aria-hidden="true">↗</span>
        </a>
        <a
          href="https://neonatox-sources.gitlab.io/packages/"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 border border-cyan-500 text-cyan-600 hover:bg-cyan-500/10 font-semibold px-6 py-4 rounded-xl transition-colors"
        >
          {p.catalogLink}
        </a>
      </div>
    </section>

    <img
      src="/screenshots/portal-de-fuentes-catalogo.png"
      alt={p.screenshotAlt}
      class="w-full h-auto rounded-xl border border-gray-200 shadow-sm mb-12"
      loading="lazy"
    />

    <!-- Qué ofrece el portal -->
    <section class="grid md:grid-cols-3 gap-6 mb-12">
      {p.cards.map((card, index) => (
        <div class="bg-gray-50 p-6 rounded-xl border border-gray-200">
          <div class="text-cyan-500 font-mono text-sm mb-3">0{index + 1}</div>
          <h2 class="text-xl font-semibold mb-3">{card.title}</h2>
          <p class="text-gray-600 text-sm leading-relaxed">{card.desc}</p>
        </div>
      ))}
    </section>

    <!-- Bloque destacado -->
    <section class="bg-gradient-to-r from-cyan-500/10 to-purple-500/10 border border-cyan-500/30 rounded-2xl p-8 mb-10">
      <h2 class="text-2xl font-bold mb-3">{p.sectionTitle}</h2>
      <p class="text-gray-600 mb-6">{p.sectionDesc}</p>
      <a
        href="https://neonatox-sources.gitlab.io/"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 bg-gradient-to-r from-cyan-500 to-purple-500 hover:from-cyan-400 hover:to-purple-400 text-white font-bold px-8 py-4 rounded-xl shadow-lg shadow-cyan-500/20 transition-all"
      >
        {p.button} <span aria-hidden="true">↗</span>
      </a>
    </section>

    <!-- Enlaces relacionados -->
    <div class="flex flex-wrap gap-6 text-sm text-cyan-600">
      <a href="/es/blog/portal-de-fuentes" class="underline hover:text-cyan-800">{p.blogLink}</a>
      <a href="/es/ruta-constructor" class="underline hover:text-cyan-800">{p.builderLink}</a>
    </div>
  </main>
</BaseLayout>
