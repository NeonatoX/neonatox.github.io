---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PackageStats from '../../components/PackageStats.astro';
import { dict } from '../../utils/i18n';
const t = dict.es;
---

<BaseLayout title="Inicio" description="Neonatox: aprende Linux construyéndolo desde cero. Distro experimental, educativa y transparente." lang="es">
  <!-- HERO -->
  <section class="relative min-h-[80vh] flex items-center justify-center overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-b from-slate-900 via-slate-900 to-slate-950"></div>
    <div class="absolute inset-0 opacity-20" style="background-image: radial-gradient(circle at 2px 2px, rgba(0,245,255,0.3) 1px, transparent 0); background-size: 40px 40px;"></div>
    
    <div class="relative z-10 max-w-4xl mx-auto px-4 text-center">
      <h1 class="text-5xl md:text-7xl font-bold mb-6">
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-purple-500">
          {t.heroTitle}
        </span>
      </h1>
      <p class="text-xl md:text-2xl text-slate-300 mb-8 max-w-2xl mx-auto leading-relaxed">
        {t.heroDesc}
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center mb-6">
        <a href="/es/ruta-constructor" class="bg-cyan-500 hover:bg-cyan-400 text-slate-900 font-bold text-lg px-8 py-4 rounded-lg transition-all transform hover:scale-105">
          {t.ctaStart}
        </a>
        <a href="/es/arquitectura" class="border-2 border-cyan-500 text-cyan-400 hover:bg-cyan-500/10 font-bold text-lg px-8 py-4 rounded-lg transition-all">
          {t.ctaArch}
        </a>
      </div>
      <div class="flex gap-6 justify-center text-sm text-slate-400">
        <a href="https://gitlab.com/neonatox-sources" target="_blank" class="text-slate-400 hover:text-cyan-400 transition-colors">→ {t.githubLink}</a>
        <a href="https://gitlab.com/neonatox-sources/neonatox-nhopkg" target="_blank" class="text-slate-400 hover:text-cyan-400 transition-colors">→ nhopkg</a>
        <a href="https://gitlab.com/neonatox-sources/neonatox-live-boot" target="_blank" class="text-slate-400 hover:text-cyan-400 transition-colors">→ Live Boot</a>
      </div>
    </div>
  </section>

  <!-- QUÉ ES NEONATOX -->
  <section class="py-24 px-4 bg-slate-800/30">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl font-bold text-center mb-8 text-white">{t.queEsNeonatox}</h2>
      <p class="text-xl text-center text-slate-300 mb-12 max-w-3xl mx-auto">{t.queEsDesc}</p>
      
      <div class="grid grid-cols-2 md:grid-cols-3 gap-6">
        <div class="bg-slate-900 p-5 rounded-lg border border-slate-700 text-center">
          <div class="text-cyan-400 text-2xl mb-2">🔧</div>
          <h3 class="text-white font-semibold mb-1">{t.lfsBased}</h3>
          <p class="text-slate-400 text-sm">{t.lfsBasedDesc}</p>
        </div>
        <div class="bg-slate-900 p-5 rounded-lg border border-slate-700 text-center">
          <div class="text-cyan-400 text-2xl mb-2">📦</div>
          <h3 class="text-white font-semibold mb-1">{t.nhopkgMgr}</h3>
          <p class="text-slate-400 text-sm">{t.nhopkgMgrDesc}</p>
        </div>
        <div class="bg-slate-900 p-5 rounded-lg border border-slate-700 text-center">
          <div class="text-cyan-400 text-2xl mb-2">⚙️</div>
          <h3 class="text-white font-semibold mb-1">{t.systemdInit}</h3>
          <p class="text-slate-400 text-sm">{t.systemdInitDesc}</p>
        </div>
        <div class="bg-slate-900 p-5 rounded-lg border border-slate-700 text-center">
          <div class="text-cyan-400 text-2xl mb-2">🔄</div>
          <h3 class="text-white font-semibold mb-1">{t.multilib}</h3>
          <p class="text-slate-400 text-sm">{t.multilibDesc}</p>
        </div>
        <div class="bg-slate-900 p-5 rounded-lg border border-slate-700 text-center">
          <div class="text-cyan-400 text-2xl mb-2">📡</div>
          <h3 class="text-white font-semibold mb-1">{t.rollingRelease}</h3>
          <p class="text-slate-400 text-sm">{t.rollingReleaseDesc}</p>
        </div>
        <div class="bg-slate-900 p-5 rounded-lg border border-slate-700 text-center">
          <div class="text-cyan-400 text-2xl mb-2">🔍</div>
          <h3 class="text-white font-semibold mb-1">{t.transparentPack}</h3>
          <p class="text-slate-400 text-sm">{t.transparentPackDesc}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FILOSOFÍA / PAQUETES -->
  <section class="py-24 px-4">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl font-bold text-center mb-12">
        <span class="text-purple-400">{t.pkgRuleTitle}</span>
      </h2>
      
      <div class="grid md:grid-cols-2 gap-8">
        <div class="bg-slate-800/50 p-6 rounded-xl border border-slate-700 hover:border-cyan-500/50 transition-colors">
          <div class="text-cyan-400 text-4xl font-mono mb-4">01</div>
          <h3 class="text-xl font-semibold text-white mb-3">Transparente</h3>
          <p class="text-slate-400">Cada paquete es un documento. Abre el *.srcnho, en el archivo nhoid, y ves exactamente qué hace, qué dependencias tiene, cómo se integra con el sistema.</p>
        </div>
        
        <div class="bg-slate-800/50 p-6 rounded-xl border border-slate-700 hover:border-cyan-500/50 transition-colors">
          <div class="text-cyan-400 text-4xl font-mono mb-4">02</div>
          <h3 class="text-xl font-semibold text-white mb-3">Educativo</h3>
          <p class="text-slate-400">Leer un PKG es como tomar una clase magistral. Entiendes no solo qué instala, sino cómo y por qué.</p>
        </div>
        
        <div class="bg-slate-800/50 p-6 rounded-xl border border-slate-700 hover:border-cyan-500/50 transition-colors">
          <div class="text-cyan-400 text-4xl font-mono mb-4">03</div>
          <h3 class="text-xl font-semibold text-white mb-3">Nativo</h3>
          <p class="text-slate-400">nhopkg es nuestro gestor de paquetes. Propio, minimalista, diseñado para enseñar mientras instala.</p>
        </div>
        
        <div class="bg-slate-800/50 p-6 rounded-xl border border-slate-700 hover:border-cyan-500/50 transition-colors">
          <div class="text-cyan-400 text-4xl font-mono mb-4">04</div>
          <h3 class="text-xl font-semibold text-white mb-3">Desde LFS</h3>
          <p class="text-slate-400">Todo comenzó desde /tools. Toolchain compilado desde cero. La cadena de construcción es visible, no hay secretos.</p>
        </div>
      </div>
      
      <div class="text-center mt-12">
        <a href="/es/paquetes" class="text-cyan-400 hover:text-cyan-300 text-lg font-medium">
          Ver ejemplo: Transmission →
        </a>
      </div>
    </div>
  </section>

  <!-- SCREENSHOTS PLACEHOLDER -->
  <section class="py-24 px-4 bg-slate-800/30">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="text-3xl font-bold text-white mb-8">Neonatox en acción</h2>
      <div class="grid md:grid-cols-2 gap-6">
        <a href="/screenshots/gnome50.png" target="_blank" class="block bg-slate-900 rounded-lg border border-slate-700 overflow-hidden hover:border-cyan-500/50 transition-colors cursor-zoom-in">
          <img src="/screenshots/gnome50.png" alt="GNOME 50 en Neonatox" class="w-full h-auto" loading="lazy">
        </a>
        <a href="/screenshots/xfce.png" target="_blank" class="block bg-slate-900 rounded-lg border border-slate-700 overflow-hidden hover:border-cyan-500/50 transition-colors cursor-zoom-in">
          <img src="/screenshots/xfce.png" alt="XFCE en Neonatox" class="w-full h-auto" loading="lazy">
        </a>
        <a href="/screenshots/kde.png" target="_blank" class="block bg-slate-900 rounded-lg border border-slate-700 overflow-hidden hover:border-cyan-500/50 transition-colors cursor-zoom-in">
          <img src="/screenshots/kde.png" alt="KDE en Neonatox" class="w-full h-auto" loading="lazy">
        </a>
        <a href="/screenshots/nhopkg.png" target="_blank" class="block bg-slate-900 rounded-lg border border-slate-700 overflow-hidden hover:border-cyan-500/50 transition-colors cursor-zoom-in">
          <img src="/screenshots/nhopkg.png" alt="nhopkg en acción" class="w-full h-auto" loading="lazy">
        </a>
        <a href="/screenshots/live-boot1.png" target="_blank" class="block bg-slate-900 rounded-lg border border-slate-700 overflow-hidden hover:border-cyan-500/50 transition-colors cursor-zoom-in">
          <img src="/screenshots/live-boot1.png" alt="Live Boot 1" class="w-full h-auto" loading="lazy">
        </a>
        <a href="/screenshots/live-boot2.png" target="_blank" class="block bg-slate-900 rounded-lg border border-slate-700 overflow-hidden hover:border-cyan-500/50 transition-colors cursor-zoom-in">
          <img src="/screenshots/live-boot2.png" alt="Live Boot 2" class="w-full h-auto" loading="lazy">
        </a>
      </div>
    </div>
  </section>

  <!-- PARA QUIÉN ES -->
  <section class="py-24 px-4">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl font-bold text-center mb-4 text-white">{t.paraQuien}</h2>
      <p class="text-center text-slate-300 mb-12">{t.paraQuienDesc}</p>
      
      <div class="grid md:grid-cols-2 gap-6">
        <div class="bg-slate-800/50 p-6 rounded-xl border border-slate-700">
          <h3 class="text-lg font-semibold text-cyan-400 mb-2">{t.learners}</h3>
          <p class="text-slate-400 text-sm">{t.learnersDesc}</p>
        </div>
        <div class="bg-slate-800/50 p-6 rounded-xl border border-slate-700">
          <h3 class="text-lg font-semibold text-cyan-400 mb-2">{t.packagers}</h3>
          <p class="text-slate-400 text-sm">{t.packagersDesc}</p>
        </div>
        <div class="bg-slate-800/50 p-6 rounded-xl border border-slate-700">
          <h3 class="text-lg font-semibold text-cyan-400 mb-2">{t.lfsEnthusiasts}</h3>
          <p class="text-slate-400 text-sm">{t.lfsEnthusiastsDesc}</p>
        </div>
        <div class="bg-slate-800/50 p-6 rounded-xl border border-slate-700">
          <h3 class="text-lg font-semibold text-cyan-400 mb-2">{t.systemBuilders}</h3>
          <p class="text-slate-400 text-sm">{t.systemBuildersDesc}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- HISTORIA -->
  <section class="py-24 px-4 bg-slate-800/30">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl font-bold text-center mb-6 text-white">La historia de Neonatox</h2>
      <p class="text-lg text-slate-300 text-center mb-8 max-w-3xl mx-auto">
        Neonatox no nació porque Linux estuviera roto. Nació porque quería entenderlo. De Mandriva a LFS, de la pausa al regreso en 2023. Una distribución construida pieza por pieza para entender cómo encaja todo.
      </p>
      <div class="text-center">
        <a href="/es/historia" class="text-cyan-400 hover:text-cyan-300 text-lg font-medium">
          Leer la historia completa →
        </a>
      </div>
    </div>
  </section>

  <!-- CTA FINAL -->
  <section class="py-24 px-4 bg-slate-800/30">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="text-3xl font-bold mb-6 text-white">¿Listo para construir tu sistema?</h2>
      <p class="text-xl text-slate-300 mb-8">
        No hay atajos. Pero tienes el mapa.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/es/ruta-constructor" class="bg-gradient-to-r from-cyan-500 to-purple-600 hover:from-cyan-400 hover:to-purple-500 text-white font-bold text-lg px-8 py-4 rounded-lg transition-all transform hover:scale-105">
          Empezar ahora
        </a>
        <a href="/es/proyectos" class="border-2 border-purple-500 text-purple-400 hover:bg-purple-500/10 font-bold text-lg px-8 py-4 rounded-lg transition-all">
          Ver proyectos
        </a>
      </div>
    </div>
  </section>

  <PackageStats lang="es" />
</BaseLayout>