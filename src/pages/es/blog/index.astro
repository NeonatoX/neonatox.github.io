---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BlogIndex from '../../../components/BlogIndex.astro';
import { dict } from '../../../utils/i18n';
import {
  getAllPosts,
  getBlogPath,
  getLocaleFromSlug,
  getRssPath,
  type Locale,
} from '../../../utils/blog';

const lang: Locale = 'es';
const t = dict.es.blog;
const allPosts = await getAllPosts();
const posts = allPosts.filter((post) => getLocaleFromSlug(post.slug) === lang);

const langLinks = {
  es: getBlogPath('es'),
  en: getBlogPath('en'),
  pt: getBlogPath('pt'),
};

const alternates = [
  { hreflang: 'es', href: getBlogPath('es') },
  { hreflang: 'en', href: getBlogPath('en') },
  { hreflang: 'pt', href: getBlogPath('pt') },
  { hreflang: 'x-default', href: getBlogPath('es') },
];
---

<BaseLayout
  title="Blog"
  description={t.description}
  lang={lang}
  canonical={getBlogPath(lang)}
  rssUrl={getRssPath(lang)}
  alternates={alternates}
  langLinks={langLinks}
>
  <BlogIndex lang={lang} t={t} posts={posts} allPosts={allPosts} />
</BaseLayout>
