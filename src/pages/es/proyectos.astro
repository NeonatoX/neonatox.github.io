---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { dict } from '../../utils/i18n';
const t = dict.es;
---

<BaseLayout title="Proyectos" description={t.proyectosDesc} lang="es">
  <section class="py-20 px-4">
    <div class="max-w-4xl mx-auto">
      <h1 class="text-4xl font-bold text-gray-900 mb-4">{t.proyectosTitle}</h1>
      <p class="text-xl text-gray-600 mb-12">{t.proyectosDesc}</p>

      <div class="grid md:grid-cols-2 gap-8">
        <a href="/es/proyectos/nhopkg" class="group bg-gray-100 p-6 rounded-xl border border-gray-200 hover:border-cyan-500/50 transition-all hover:transform hover:-translate-y-1">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-12 h-12 bg-cyan-500/20 rounded-lg flex items-center justify-center">
              <span class="text-2xl">📦</span>
            </div>
            <div>
              <h2 class="text-xl font-bold text-gray-900 group-hover:text-cyan-400 transition-colors">{t.nhopkgTitle}</h2>
              <p class="text-sm text-cyan-600/70">{t.nhopkgSubtitle}</p>
            </div>
          </div>
          <p class="text-gray-500 text-sm">{t.nhopkgDesc}</p>
          <div class="mt-4 flex items-center gap-2 text-cyan-400 text-sm font-medium">
            <span class="bg-green-500/20 text-emerald-600 px-2 py-0.5 rounded text-xs">{t.estable}</span>
            <span>→</span>
          </div>
        </a>

        <a href="/es/proyectos/live-boot" class="group bg-gray-100 p-6 rounded-xl border border-gray-200 hover:border-purple-500/50 transition-all hover:transform hover:-translate-y-1">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-12 h-12 bg-purple-500/20 rounded-lg flex items-center justify-center">
              <span class="text-2xl">💿</span>
            </div>
            <div>
              <h2 class="text-xl font-bold text-gray-900 group-hover:text-purple-600 transition-colors">{t.liveBootTitle}</h2>
              <p class="text-sm text-purple-600/70">{t.liveBootSubtitle}</p>
            </div>
          </div>
          <p class="text-gray-500 text-sm">{t.liveBootDesc}</p>
          <div class="mt-4 flex items-center gap-2 text-purple-600 text-sm font-medium">
            <span class="bg-green-500/20 text-emerald-600 px-2 py-0.5 rounded text-xs">{t.estable}</span>
            <span>→</span>
          </div>
        </a>

        <a href="/es/proyectos/installer" class="group bg-gray-100 p-6 rounded-xl border border-gray-200 hover:border-yellow-500/50 transition-all hover:transform hover:-translate-y-1">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-12 h-12 bg-yellow-500/20 rounded-lg flex items-center justify-center">
              <span class="text-2xl">⚙️</span>
            </div>
            <div>
              <h2 class="text-xl font-bold text-gray-900 group-hover:text-yellow-400 transition-colors">{t.installerTitle}</h2>
              <p class="text-sm text-yellow-400/70">{t.installerSubtitle}</p>
            </div>
          </div>
          <p class="text-gray-500 text-sm">{t.installerDesc}</p>
          <div class="mt-4 flex items-center gap-2 text-yellow-400 text-sm font-medium">
            <span class="bg-yellow-500/20 text-yellow-400 px-2 py-0.5 rounded text-xs">{t.experimental}</span>
            <span>→</span>
          </div>
        </a>

        <a href="/es/proyectos/sources" class="group bg-gray-100 p-6 rounded-xl border border-gray-200 hover:border-red-500/50 transition-all hover:transform hover:-translate-y-1">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-12 h-12 bg-red-500/20 rounded-lg flex items-center justify-center">
              <span class="text-2xl">📚</span>
            </div>
            <div>
              <h2 class="text-xl font-bold text-gray-900 group-hover:text-red-600 transition-colors">{t.sourcesTitle}</h2>
              <p class="text-sm text-red-600/70">{t.sourcesSubtitle}</p>
            </div>
          </div>
          <p class="text-gray-500 text-sm">{t.sourcesDesc}</p>
          <div class="mt-4 flex items-center gap-2 text-red-600 text-sm font-medium">
            <span class="bg-slate-500/20 text-gray-500 px-2 py-0.5 rounded text-xs">GitLab</span>
            <span>→</span>
          </div>
        </a>

        <a href="/es/proyectos/bootstrap" class="group bg-gray-100 p-6 rounded-xl border border-gray-200 hover:border-emerald-500/50 transition-all hover:transform hover:-translate-y-1">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-12 h-12 bg-emerald-500/20 rounded-lg flex items-center justify-center">
              <span class="text-2xl">🚀</span>
            </div>
            <div>
              <h2 class="text-xl font-bold text-gray-900 group-hover:text-emerald-600 transition-colors">{t.bootstrapTitle}</h2>
              <p class="text-sm text-emerald-600/70">{t.bootstrapSubtitle}</p>
            </div>
          </div>
          <p class="text-gray-500 text-sm">{t.bootstrapDesc}</p>
          <div class="mt-4 flex items-center gap-2 text-emerald-600 text-sm font-medium">
            <span class="bg-green-500/20 text-emerald-600 px-2 py-0.5 rounded text-xs">{t.estable}</span>
            <span>→</span>
          </div>
        </a>
      </div>

      <div class="mt-16 bg-gray-50 p-6 rounded-lg border border-gray-200">
        <h3 class="text-lg font-semibold text-gray-900 mb-4">La base: Linux From Scratch</h3>
        <p class="text-gray-600 text-sm mb-4">
          Todo comenzó con <a href="https://www.linuxfromscratch.org/" target="_blank" class="text-cyan-500 hover:text-cyan-700 underline">Linux From Scratch (LFS)</a>. 
          Es labase sobre la que Neonatox construye: un sistema operativo compilado manualmente, 
          paquete por paquete, desde el código fuente.
        </p>
        <p class="text-gray-500 text-sm">
          LFS no es solo un tutorial, es un ejercicio de comprensión profunda. 
          Cada compilador, cada biblioteca, cada servicio se configura y construye a mano.
          Neonatox toma esa base y la profesionaliza con herramientas propias.
        </p>
      </div>

      <div class="mt-8 bg-gray-50 p-6 rounded-lg border border-gray-200">
        <h3 class="text-lg font-semibold text-gray-900 mb-4">¿Cómo encajan estos proyectos?</h3>
        <div class="flex flex-col md:flex-row items-center justify-center gap-4 text-gray-600">
          <div class="flex items-center gap-2">
            <span class="text-emerald-600">🚀</span>
            <span>Bootstrap</span>
          </div>
          <span class="text-gray-400">→</span>
          <div class="flex items-center gap-2">
            <span class="text-cyan-400">📦</span>
            <span>nhopkg</span>
          </div>
          <span class="text-gray-400">→</span>
          <div class="flex items-center gap-2">
            <span class="text-purple-600">💿</span>
            <span>Live Boot</span>
          </div>
          <span class="text-gray-400">→</span>
          <div class="flex items-center gap-2">
            <span class="text-yellow-400">⚙️</span>
            <span>Installer</span>
          </div>
          <span class="text-gray-400">→</span>
          <div class="flex items-center gap-2">
            <span class="text-cyan-400">🖥️</span>
            <span>Neonatox</span>
          </div>
        </div>
        <p class="text-gray-500 text-sm mt-4 text-center">
          Bootstrap despliega el sistema → nhopkg construye los paquetes → Live Boot crea el ISO → Installer instala el sistema
        </p>
      </div>
    </div>
  </section>
</BaseLayout>