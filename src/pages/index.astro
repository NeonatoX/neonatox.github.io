<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <title>Neonatox</title>
    <noscript>
      <meta http-equiv="refresh" content="0;url=/es/" />
    </noscript>
  </head>
  <body>
    <script>
      const lang = navigator.language || navigator.userLanguage || 'es';
      const lower = lang.toLowerCase();
      let redirect = '/es/';
      
      if (lower.startsWith('pt')) {
        redirect = '/pt/';
      } else if (lower.startsWith('en')) {
        redirect = '/en/';
      }
      
      window.location.href = redirect;
    </script>
    <p>Redirigiendo a <a href="/es/">Español</a>...</p>
    <p>Redirecting to <a href="/en/">English</a>...</p>
    <p>Redirecionando para <a href="/pt/">Português</a>...</p>
  </body>
</html>