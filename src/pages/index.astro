<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Neonatox</title>
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      body {
        background: #020617;
        color: #94a3b8;
        font-family: system-ui, -apple-system, sans-serif;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 1.5rem;
        padding: 1rem;
      }
      .spinner {
        width: 40px; height: 40px;
        border: 3px solid #1e293b;
        border-top-color: #00f5ff;
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
      }
      @keyframes spin { to { transform: rotate(360deg); } }
      p { font-size: 0.9rem; line-height: 1.6; text-align: center; }
      a { color: #00f5ff; text-decoration: none; }
      a:hover { color: #67e8f9; text-decoration: underline; }
    </style>
    <noscript>
      <meta http-equiv="refresh" content="0;url=/es/" />
    </noscript>
  </head>
  <body>
    <div class="spinner"></div>
    <p>
      Redirigiendo a <a href="/es/">Español</a> · 
      <a href="/en/">English</a> · 
      <a href="/pt/">Português</a>
    </p>
    <script>
      const lang = navigator.language || navigator.userLanguage || 'es';
      const lower = lang.toLowerCase();
      let redirect = '/es/';
      
      if (lower.startsWith('pt')) {
        redirect = '/pt/';
      } else if (lower.startsWith('en')) {
        redirect = '/en/';
      }
      
      window.location.href = redirect;
    </script>
  </body>
</html>