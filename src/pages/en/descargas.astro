            Torrent / Magnet
          </a>
        </div>
        <details class="text-sm">
          <summary class="text-cyan-400 cursor-pointer hover:text-cyan-600">SHA256</summary>
          <code class="text-gray-500 text-xs break-all mt-2 block">d7cde005edcdc7518548be235cea514cc72e938ea3dbd4311f8b2bd96c49251f  neonatox-live-2026-gnome-x86_64.iso</code>
        </details>
      </div>

      <!-- KDE 6.23.0 -->
      <div class="bg-gray-100 p-6 rounded-xl border border-gray-200 mb-6">
        <div class="flex items-center gap-4 mb-4">
          <div class="w-12 h-12 bg-green-500/20 rounded-xl flex items-center justify-center font-bold text-emerald-600 text-xl">K</div>
          <div>
            <h2 class="text-2xl font-bold text-gray-900">Neonatox Live — KDE 6.23.0</h2>
            <p class="text-gray-500 text-sm">KDE Plasma 6.23.0 desktop — x86_64 — 3.8 GB</p>
          </div>
        </div>
        <div class="grid md:grid-cols-2 gap-3 mb-4">
          <a href="https://neonatox.vegnux.com/isos/neonatox-live-2026-kde-x86_64.iso" target="_blank" class="bg-cyan-500 hover:bg-cyan-400 text-white font-semibold px-4 py-3 rounded-lg transition-colors text-center">
            Direct Download
          </a>
          <a href="magnet:?xt=urn:btih:1051c92d59485640ccfdd5274808d515181c2267&dn=neonatox-live-2026-kde-x86_64.iso&tr=http%3A%2F%2F34.66.57.33%3A2701%2Fannounce&tr=http%3A%2F%2F34.66.57.33%3A2710%2Fannounce&ws=https%3A%2F%2Fneonatox.vegnux.com%2Fisos%2Fneonatox-live-2026-kde-x86_64.iso" target="_blank" class="bg-purple-500 hover:bg-purple-400 text-white font-semibold px-4 py-3 rounded-lg transition-colors text-center">
            Torrent / Magnet
          </a>
        </div>
        <details class="text-sm">
          <summary class="text-cyan-400 cursor-pointer hover:text-cyan-600">SHA256</summary>
          <code class="text-gray-500 text-xs break-all mt-2 block">e73bfbbe7589ec1fafe1701db7858836e2229f2f4ea81de55c3f470e39352640  neonatox-live-2026-kde-x86_64.iso</code>
