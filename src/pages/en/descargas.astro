        <div class="flex items-center gap-4 mb-4">
          <div class="w-12 h-12 bg-amber-500/20 rounded-xl flex items-center justify-center font-bold text-amber-600 text-xl">X</div>
          <div>
            <h2 class="text-2xl font-bold text-gray-900">Neonatox Live — XFCE 4.20</h2>
            <p class="text-gray-500 text-sm">XFCE 4.20 desktop — x86_64 — 2.8 GB</p>
          </div>
        </div>
        <div class="grid md:grid-cols-2 gap-3 mb-4">
          <a href="https://neonatox.vegnux.com/isos/neonatox-live-2026-xfce-x86_64.iso" target="_blank" class="bg-cyan-500 hover:bg-cyan-400 text-white font-semibold px-4 py-3 rounded-lg transition-colors text-center">
            Direct Download
          </a>
          <a href="magnet:?xt=urn:btih:21f17e0941e260d4d800b4b36a9aa35b858f6ef1&dn=neonatox-live-2026-xfce-x86_64.iso&tr=http%3A%2F%2F34.66.57.33%3A2701%2Fannounce&tr=http%3A%2F%2F34.66.57.33%3A2710%2Fannounce&ws=https%3A%2F%2Fneonatox.vegnux.com%2Fisos%2Fneonatox-live-2026-xfce-x86_64.iso" target="_blank" class="bg-purple-500 hover:bg-purple-400 text-white font-semibold px-4 py-3 rounded-lg transition-colors text-center">
            Torrent / Magnet
          </a>
        </div>
        <details class="text-sm">
          <summary class="text-cyan-400 cursor-pointer hover:text-cyan-600">SHA256</summary>
          <code class="text-gray-500 text-xs break-all mt-2 block">26d861c5cfea1d1158164fa1f1a45ccff1404afca0ee6a56f861c925feb64b05  neonatox-live-2026-xfce-x86_64.iso</code>
        </details>
      </div>

      <!-- Credentials -->
      <div class="bg-gray-100 p-6 rounded-lg border border-gray-200 mb-8">
        <h2 class="text-xl font-bold text-cyan-700 mb-4">ISO Credentials</h2>
        <div class="grid md:grid-cols-2 gap-4">
          <div class="bg-gray-50 p-4 rounded-lg">
            <p class="text-gray-500 text-sm">User</p>
            <p class="text-gray-900 font-mono">neonatox</p>
            <p class="text-gray-500 text-sm mt-2">Password</p>
            <p class="text-gray-900 font-mono">neonatox</p>
          </div>
          <div class="bg-gray-50 p-4 rounded-lg">
            <p class="text-gray-500 text-sm">User</p>
            <p class="text-gray-900 font-mono">root</p>
            <p class="text-gray-500 text-sm mt-2">Password</p>
            <p class="text-gray-900 font-mono">neonatox</p>
          </div>
        </div>
      </div>

      <!-- VirtualBox -->
      <div class="bg-cyan-500/10 border border-cyan-500/30 rounded-lg p-6 mb-8">
        <p class="text-cyan-700 text-sm">
          <strong>Recommendation:</strong> All ISOs were tested using <strong>VirtualBox</strong>.
          If you want to try them risk-free, we recommend using VirtualBox as a virtual machine.
        </p>
      </div>

      <!-- Requirements -->
      <div class="bg-gray-100 p-6 rounded-lg border border-gray-200 mb-8">
        <h2 class="text-xl font-bold text-cyan-700 mb-4">System Requirements</h2>
        <ul class="space-y-2 text-gray-600">
          <li>• <strong>CPU:</strong> x86_64 (AMD64 or Intel 64 compatible)</li>
          <li>• <strong>RAM:</strong> Minimum 2GB, recommended 4GB+</li>
          <li>• <strong>Storage:</strong> 10GB free for installation</li>
          <li>• <strong>Graphics:</strong> Compatible DRM driver (Intel, AMD, NVIDIA)</li>
        </ul>
      </div>

      <!-- Installation -->
      <div class="bg-gray-100 p-6 rounded-lg border border-gray-200">
        <h2 class="text-xl font-bold text-cyan-700 mb-4">How to Install</h2>
        <ol class="list-decimal list-slate-300 space-y-2 pl-4">
          <li>Download the ISO image</li>
          <li>Verify the SHA256 hash</li>
          <li>Burn the ISO to a USB (use <code>dd</code> or Ventoy)</li>
          <li>Boot from USB</li>
          <li>Run the installer from the live desktop</li>
        </ol>
        <p class="text-gray-500 text-sm mt-4">
          More details at <a href="/en/proyectos/installer" class="text-cyan-500 hover:text-cyan-700 underline">Neonatox Installer</a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
