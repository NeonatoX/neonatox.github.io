      <p class="text-xl text-gray-600 mb-12">
        Pick your Neonatox flavor and try it on your machine.
      </p>

      <!-- GNOME 50 -->
      <div class="bg-gray-100 p-6 rounded-xl border border-gray-200 mb-6">
        <div class="flex items-center gap-4 mb-4">
          <div class="w-12 h-12 bg-blue-500/20 rounded-xl flex items-center justify-center font-bold text-blue-400 text-xl">G</div>
          <div>
            <h2 class="text-2xl font-bold text-gray-900">Neonatox Live — GNOME 50</h2>
            <p class="text-gray-500 text-sm">GNOME 50 desktop — x86_64 — 2.8 GB</p>
          </div>
        </div>
        <div class="grid md:grid-cols-2 gap-3 mb-4">
          <a href="https://neonatox.vegnux.com/isos/neonatox-live-2026-gnome-x86_64.iso" target="_blank" class="bg-cyan-500 hover:bg-cyan-400 text-white font-semibold px-4 py-3 rounded-lg transition-colors text-center">
            Direct Download
