---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { dict } from '../../utils/i18n';
const t = dict.en;
---

<BaseLayout title="Downloads" description="Download Neonatox ISO" lang="en">
  <section class="py-20 px-4">
    <div class="max-w-4xl mx-auto">
      <h1 class="text-4xl font-bold text-cyan-400 mb-8">Downloads</h1>
      <p class="text-xl text-slate-300 mb-12">
        Get Neonatox and try it on your machine.
      </p>

      <!-- ISO Principal -->
      <div class="bg-slate-800/50 p-8 rounded-xl border border-slate-700 mb-8">
        <div class="flex items-center justify-between mb-6">
          <div>
            <h2 class="text-2xl font-bold text-white">Neonatox ISO</h2>
            <p class="text-slate-400">Live image ready-to-use</p>
          </div>
          <span class="bg-yellow-500/20 text-yellow-400 px-3 py-1 rounded-full text-sm">Coming Soon</span>
        </div>
        
        <div class="grid md:grid-cols-2 gap-6">
          <div class="bg-slate-900 p-4 rounded-lg">
            <h3 class="text-cyan-400 font-semibold mb-2">Image Information</h3>
            <ul class="text-slate-400 text-sm space-y-1">
              <li><strong>Version:</strong> --</li>
              <li><strong>Architecture:</strong> x86_64</li>
              <li><strong>Size:</strong> --</li>
              <li><strong>Kernel:</strong> --</li>
            </ul>
          </div>
          <div class="bg-slate-900 p-4 rounded-lg">
            <h3 class="text-cyan-400 font-semibold mb-2">SHA256</h3>
            <code class="text-slate-500 text-xs break-all">--</code>
          </div>
        </div>
      </div>

      <!-- Opciones de descarga -->
      <div class="grid md:grid-cols-2 gap-6 mb-12">
        <div class="bg-slate-800/30 p-6 rounded-lg border border-slate-700 opacity-75">
          <div class="flex items-center gap-3 mb-4">
            <span class="text-2xl">🌐</span>
            <div>
              <h3 class="text-white font-semibold">Direct Download</h3>
              <p class="text-slate-400 text-sm">HTTP</p>
            </div>
          </div>
          <p class="text-slate-500 text-sm">Coming soon</p>
        </div>

        <div class="bg-slate-800/30 p-6 rounded-lg border border-slate-700 opacity-75">
          <div class="flex items-center gap-3 mb-4">
            <span class="text-2xl">🔗</span>
            <div>
              <h3 class="text-white font-semibold">Torrent</h3>
              <p class="text-slate-400 text-sm">P2P</p>
            </div>
          </div>
          <p class="text-slate-500 text-sm">Coming soon</p>
        </div>
      </div>

      <!-- Requisitos -->
      <div class="bg-slate-800/50 p-6 rounded-lg border border-slate-700 mb-8">
        <h2 class="text-xl font-bold text-cyan-300 mb-4">System Requirements</h2>
        <ul class="space-y-2 text-slate-300">
          <li>• <strong>CPU:</strong> x86_64 (AMD64 or Intel 64 compatible)</li>
          <li>• <strong>RAM:</strong> Minimum 2GB, recommended 4GB+</li>
          <li>• <strong>Storage:</strong> 10GB free for installation</li>
          <li>• <strong>Graphics:</strong> Compatible DRM driver (Intel, AMD, NVIDIA)</li>
        </ul>
      </div>

      <!-- Instalación -->
      <div class="bg-slate-800/50 p-6 rounded-lg border border-slate-700">
        <h2 class="text-xl font-bold text-cyan-300 mb-4">How to Install</h2>
        <ol class="list-decimal list-slate-300 space-y-2 pl-4">
          <li>Download the ISO image</li>
          <li>Verify the SHA256 hash</li>
          <li>Burn the ISO to a USB (use <code>dd</code> or Ventoy)</li>
          <li>Boot from USB</li>
          <li>Run the installer from the live desktop</li>
        </ol>
        <p class="text-slate-400 text-sm mt-4">
          More details at <a href="/en/proyectos/installer" class="text-cyan-400 hover:text-cyan-300 underline">Neonatox Installer</a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>