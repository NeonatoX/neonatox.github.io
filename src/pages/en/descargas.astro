---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { dict } from '../../utils/i18n';
const t = dict.en;
---

<BaseLayout title="Downloads" description="Download Neonatox ISOs" lang="en">
  <section class="py-20 px-4">
    <div class="max-w-4xl mx-auto">
